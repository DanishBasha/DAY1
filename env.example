# ==========================================================================
# SoDak EduTech - Agentic AI Day 1
# Groq API configuration
# Copy this file to ".env" and add your Groq API key.
# Never commit the .env file.
# ==========================================================================

# Active provider
PROVIDER=groq

# --- Groq ---------------------------------------------------------------
# Get your API key from the Groq Console:
# https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here

# Models can be overridden if needed.
# MODEL_MAIN=llama-3.3-70b-versatile
# MODEL_CHEAP=llama-3.1-8b-instant

# --- Optional: other providers ------------------------------------------
# PROVIDER=gemini
# GEMINI_API_KEY=paste-your-gemini-key-here

# PROVIDER=ollama
# OLLAMA_API_KEY=ollama-local

# PROVIDER=openai
# OPENAI_API_KEY=paste-your-openai-key-here

# ==========================================================================
# Optional overrides
# ==========================================================================

# MAX_RETRIES=5
# RETRY_BASE_DELAY=3.0
